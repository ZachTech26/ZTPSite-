---
import Layout from '../layouts/Layout.astro';
import { projects, statusLabel } from '../data/projects.js';

const featuredProjects = projects;

const latestPosts = [
  { title: 'ztp. init', date: '04 Aug 2026', href: '/blog/ztp-init' },
];
---
<Layout title="ZTP. Building, learning and documenting my tech journey." description="Thoughts, stories and ideas from an IT professional documenting his tech journey.">
  <section class="tight">
    <div class="wrap">
      <div class="term-window">
        <div class="term-titlebar">
          <span class="term-dot"></span>
          <span class="term-dot"></span>
          <span class="term-dot"></span>
          <span>zach — ztp — 80x24</span>
        </div>
        <div class="term-body">
          <p class="term-dim">$ ztp --status</p>
          <p class="term-accent">&gt;ztp. Building, learning and documenting my tech journey, one project at a time.</p>
          <p class="term-dim">$ whoami</p>
          <p>Zach — IT professional, building up cloud infrastructure, Azure and cybersecurity skills.</p>
          <p class="term-dim">$ <span class="cursor"></span></p>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <span class="eyebrow">&gt;ztp. current projects</span>
      <h2>What I'm building</h2>
      <hr class="rule" />
      <div class="grid">
        {featuredProjects.map((p) => (
          <a class="card" href={`/projects/${p.slug}`}>
            <div class="card-title">{p.title}</div>
            <p class="card-desc">{p.desc}</p>
            <span class="status">
              <span class={`status-dot ${p.status}`}></span>
              {statusLabel(p.status)}
            </span>
            <div class="tags">
              {p.tags.map((t) => <span class="tag">{t}</span>)}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <span class="eyebrow">&gt;ztp. latest writing</span>
      <h2>From the blog</h2>
      <hr class="rule" />
      {latestPosts.map((post) => (
        <a class="post-row" href={post.href}>
          <span class="post-title">{post.title}</span>
          <span class="post-date">{post.date}</span>
        </a>
      ))}
    </div>
  </section>
</Layout>